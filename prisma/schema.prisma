
// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum untuk peran pengguna
enum Role {
  PELANGGAN
  PENGUSAHA
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // Kita akan hash password ini
  role          Role      @default(PELANGGAN) // Default role adalah pelanggan
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relasi: Satu user bisa punya banyak UMKM
  umkms   Umkm[]
  // Relasi: Satu user bisa menulis banyak review
  reviews Review[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)
  Umkm Umkm[]

  @@index([slug], map: "idx_category_slug")
}

model Umkm {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(255)
  description     String?
  address         String
  phone           String?           @db.VarChar(20)
  openingHours    String?           @db.VarChar(100)
  photos          String[]
  latitude        Float?
  longitude       Float?
  rating          Decimal?          @default(4.0) @db.Decimal(2, 1)
  hasPromo        Boolean?          @default(false)
  isRecommended   Boolean?          @default(false)
  categoryId      Int
  ProductCategory ProductCategory[]
  Review          Review[]
  Category        Category          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relasi ke pemilik UMKM
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])


  @@index([name], map: "idx_umkm_name")
  @@index([slug], map: "idx_umkm_slug")
  @@index([ownerId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  umkmId    Int
  Umkm      Umkm     @relation(fields: [umkmId], references: [id])

  // Relasi ke user yang menulis review
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([umkmId])
}

model Product {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(255)
  description       String?
  price             Int?
  photo             String?         @db.VarChar(255)
  isFeatured        Boolean?        @default(false)
  productCategoryId Int
  ProductCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@index([productCategoryId])
}

model ProductCategory {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(100)
  umkmId  Int
  Product Product[]
  Umkm    Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
}
