model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  umkmId    Int
  userId    String
  
  // Relasi
  Umkm      Umkm     @relation(fields: [umkmId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([umkmId])
  @@index([userId])
}

model Product {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(255)
  description       String?
  price             Int?
  photo             String?         @db.VarChar(255)
  isFeatured        Boolean?        @default(false)
  productCategoryId Int
  ProductCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@index([productCategoryId])
}

model ProductCategory {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(100)
  umkmId  Int
  Product Product[]
  Umkm    Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
}
