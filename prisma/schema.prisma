/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  author    String   @default("Pengunjung") @db.VarChar(100)
  createdAt DateTime @default(now())
  umkmId    Int
  Umkm      Umkm     @relation(fields: [umkmId], references: [id])

  @@index([umkmId])
}

model Product {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(255)
  description       String?
  price             Int?
  photo             String?         @db.VarChar(255)
  isFeatured        Boolean?        @default(false)
  productCategoryId Int
  ProductCategory   ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@index([productCategoryId])
}

model ProductCategory {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(100)
  umkmId  Int
  Product Product[]
  Umkm    Umkm      @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([umkmId])
}
